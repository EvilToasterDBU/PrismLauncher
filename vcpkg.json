{
  "dependencies": [
    {
      "name": "ecm",
      "host": true
    },
    {
      "name": "libqrencode",
      "default-features": false
    },
    {
      "name": "pkgconf",
      "host": true,
      "platform": "windows & !mingw"
    },

    "cmark",
    {
      "name": "libarchive",
      "default-features": false,
      "features": [
        "bzip2",
        "lz4",
        "lzma",
        "lzo",
        "zstd"
      ]
    },
    "tomlplusplus",
    "zlib"
  ],
  "features": {
    "bigscreen": {
      "description": "SDL2 + fmt for the BigScreen front-end (bigscreen/). Windows only: Linux builds use the system packages via pkg-config instead. Enabled with -DVCPKG_MANIFEST_FEATURES=bigscreen, so the regular desktop build never pays for them.",
      "dependencies": [
        {
          "name": "sdl2",
          "platform": "windows"
        },
        {
          "name": "fmt",
          "platform": "windows"
        }
      ]
    }
  }
}
